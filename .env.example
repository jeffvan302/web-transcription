# Copy to .env and adjust. Every value is optional for local development.

# --- App ---
# NODE_ENV=development
# APP_PORT=3001
# APP_BASE_URL=http://localhost:4173
# APP_DATA_DIR=./data
# SESSION_COOKIE_NAME=
# SESSION_TTL_MS=

# --- Bootstrap admin (production) ---
# If BOOTSTRAP_ADMIN_PASSWORD is unset, a random one-time password is printed to the server log on first startup.
# BOOTSTRAP_ADMIN_LOGIN_IDENTITY=admin
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_USERS_JSON=

# --- Transcription (choose one, or neither for manual transcription) ---
# OPENAI_API_KEY=
# OPENAI_TRANSCRIPTION_MODEL=
# WHISPER_MODEL_PATH=

# --- Media tools (defaults to binaries on PATH) ---
# FFMPEG_PATH=
# FFPROBE_PATH=
# YT_DLP_PATH=

# --- Object storage (S3-compatible; defaults to local disk) ---
# STORAGE_PROVIDER=
# STORAGE_BUCKET=
# STORAGE_PREFIX=workspace/
# STORAGE_ENDPOINT_URL=
# STORAGE_REGION=
# STORAGE_ADDRESSING_MODE=path
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_AUDIT_VISIBLE=true
